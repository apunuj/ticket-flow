{
  "$id": "feature-record-v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "$ref": "#/definitions/artifact"
    },
    {
      "$ref": "#/definitions/revision"
    },
    {
      "$ref": "#/definitions/approval"
    },
    {
      "$ref": "#/definitions/checkpoint"
    },
    {
      "$ref": "#/definitions/review"
    }
  ],
  "definitions": {
    "artifact": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "recordType": {
          "const": "artifact"
        },
        "recordId": {
          "type": "string",
          "minLength": 1
        },
        "revisionId": {
          "type": "string",
          "minLength": 1
        },
        "featureId": {
          "$ref": "feature-common-v1#/definitions/uuid"
        },
        "createdAt": {
          "$ref": "feature-common-v1#/definitions/timestamp"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1
        },
        "storageRef": {
          "$ref": "feature-common-v1#/definitions/trackerRef"
        },
        "hash": {
          "$ref": "feature-common-v1#/definitions/hash"
        },
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "prd",
            "spec",
            "slices"
          ]
        },
        "body": {
          "type": "string"
        },
        "bodyHash": {
          "$ref": "feature-common-v1#/definitions/hash"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "feature-common-v1#/definitions/revisionRef"
          }
        }
      },
      "required": [
        "schemaVersion",
        "recordType",
        "recordId",
        "revisionId",
        "featureId",
        "createdAt",
        "artifactId",
        "kind",
        "body",
        "bodyHash",
        "sources"
      ],
      "additionalProperties": false
    },
    "revision": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "recordType": {
          "const": "revision"
        },
        "recordId": {
          "type": "string",
          "minLength": 1
        },
        "revisionId": {
          "type": "string",
          "minLength": 1
        },
        "featureId": {
          "$ref": "feature-common-v1#/definitions/uuid"
        },
        "createdAt": {
          "$ref": "feature-common-v1#/definitions/timestamp"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1
        },
        "storageRef": {
          "$ref": "feature-common-v1#/definitions/trackerRef"
        },
        "hash": {
          "$ref": "feature-common-v1#/definitions/hash"
        },
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "prd",
            "spec",
            "slices"
          ]
        },
        "body": {
          "type": "string"
        },
        "bodyHash": {
          "$ref": "feature-common-v1#/definitions/hash"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "feature-common-v1#/definitions/revisionRef"
          }
        }
      },
      "required": [
        "schemaVersion",
        "recordType",
        "recordId",
        "revisionId",
        "featureId",
        "createdAt",
        "artifactId",
        "kind",
        "body",
        "bodyHash",
        "sources"
      ],
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "recordType": {
          "const": "approval"
        },
        "recordId": {
          "type": "string",
          "minLength": 1
        },
        "revisionId": {
          "type": "string",
          "minLength": 1
        },
        "featureId": {
          "$ref": "feature-common-v1#/definitions/uuid"
        },
        "createdAt": {
          "$ref": "feature-common-v1#/definitions/timestamp"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1
        },
        "storageRef": {
          "$ref": "feature-common-v1#/definitions/trackerRef"
        },
        "hash": {
          "$ref": "feature-common-v1#/definitions/hash"
        },
        "target": {
          "$ref": "feature-common-v1#/definitions/revisionRef"
        },
        "decision": {
          "type": "object",
          "properties": {
            "kind": {
              "const": "approved"
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "reference": {
              "type": "string",
              "minLength": 1
            },
            "actor": {
              "type": "string",
              "minLength": 1
            },
            "at": {
              "$ref": "feature-common-v1#/definitions/timestamp"
            },
            "qualifications": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "kind",
            "text",
            "reference",
            "actor",
            "at",
            "qualifications"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "recordType",
        "recordId",
        "revisionId",
        "featureId",
        "createdAt",
        "target",
        "decision"
      ],
      "additionalProperties": false
    },
    "checkpoint": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "recordType": {
          "const": "checkpoint"
        },
        "recordId": {
          "type": "string",
          "minLength": 1
        },
        "revisionId": {
          "type": "string",
          "minLength": 1
        },
        "featureId": {
          "$ref": "feature-common-v1#/definitions/uuid"
        },
        "createdAt": {
          "$ref": "feature-common-v1#/definitions/timestamp"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1
        },
        "storageRef": {
          "$ref": "feature-common-v1#/definitions/trackerRef"
        },
        "hash": {
          "$ref": "feature-common-v1#/definitions/hash"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "questionId": {
                "type": "string",
                "minLength": 1
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "answer": {
                "type": "string"
              }
            },
            "required": [
              "questionId",
              "prompt"
            ],
            "additionalProperties": false
          }
        },
        "productDecisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "technicalDecisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unresolvedItems": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "nextFocus": {
          "type": "string",
          "minLength": 1
        },
        "resultingRevision": {
          "$ref": "feature-common-v1#/definitions/revisionRef"
        }
      },
      "required": [
        "schemaVersion",
        "recordType",
        "recordId",
        "revisionId",
        "featureId",
        "createdAt",
        "questions",
        "productDecisions",
        "technicalDecisions",
        "assumptions",
        "unresolvedItems",
        "nextFocus",
        "resultingRevision"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "recordType": {
          "const": "review"
        },
        "recordId": {
          "type": "string",
          "minLength": 1
        },
        "revisionId": {
          "type": "string",
          "minLength": 1
        },
        "featureId": {
          "$ref": "feature-common-v1#/definitions/uuid"
        },
        "createdAt": {
          "$ref": "feature-common-v1#/definitions/timestamp"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1
        },
        "storageRef": {
          "$ref": "feature-common-v1#/definitions/trackerRef"
        },
        "hash": {
          "$ref": "feature-common-v1#/definitions/hash"
        },
        "target": {
          "$ref": "feature-common-v1#/definitions/revisionRef"
        },
        "baselineEvidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "findingId": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "disposition": {
                "enum": [
                  "open",
                  "addressed",
                  "deferred",
                  "rejected"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "findingId",
              "description",
              "disposition"
            ],
            "additionalProperties": false
          }
        },
        "resultingRevision": {
          "$ref": "feature-common-v1#/definitions/revisionRef"
        },
        "readiness": {
          "enum": [
            "ready",
            "blocked"
          ]
        },
        "unresolvedDecisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "schemaVersion",
        "recordType",
        "recordId",
        "revisionId",
        "featureId",
        "createdAt",
        "target",
        "baselineEvidence",
        "findings",
        "readiness",
        "unresolvedDecisions"
      ],
      "additionalProperties": false
    }
  }
}
